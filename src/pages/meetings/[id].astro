---
import Layout from "@/layouts/Layout.astro";
import { MeetingCapture } from "@/components/meetings/MeetingCapture";

const meetingId = Astro.params.id ?? "";
---

<Layout title="Meeting">
  <div class="bg-cosmic min-h-screen p-4 md:p-8">
    <div class="mx-auto w-full max-w-6xl">
      <MeetingCapture client:load meetingId={meetingId} />
    </div>
  </div>
</Layout>
