# Cloud (default) — Project URL + anon/publishable key from Supabase → Project Settings → API
# Keep identical values in .env and .dev.vars (Wrangler reads .dev.vars for npm run dev).
# Do NOT use the service_role / secret key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Local Docker alternative (only after `npx supabase start`; copy printed keys):
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_KEY=<anon key from CLI output>

# Isolation tests (`npm test`). Copy real values into .env only — never commit them.
# See context/foundation/test-accounts.md.
TEST_BASE_URL=http://localhost:4321
TEST_MANAGER_A_EMAIL=
TEST_MANAGER_A_PASSWORD=
TEST_MANAGER_B_EMAIL=
TEST_MANAGER_B_PASSWORD=
